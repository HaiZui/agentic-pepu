{
  "openapi": "3.1.0",
  "info": {
    "title": "The Bottle Throne",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/shows": {
      "post": {
        "tags": [
          "shows"
        ],
        "summary": "Create Show",
        "operationId": "create_show_api_shows_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowSession"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/shows/{show_id}": {
      "get": {
        "tags": [
          "shows"
        ],
        "summary": "Get Show",
        "operationId": "get_show_api_shows__show_id__get",
        "parameters": [
          {
            "name": "show_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Show Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowSession"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/shows/{show_id}/fate": {
      "get": {
        "tags": [
          "shows"
        ],
        "summary": "Get Fate",
        "operationId": "get_fate_api_shows__show_id__fate_get",
        "parameters": [
          {
            "name": "show_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Show Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FateScript"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/shows/{show_id}/reveal": {
      "post": {
        "tags": [
          "shows"
        ],
        "summary": "Reveal",
        "operationId": "reveal_api_shows__show_id__reveal_post",
        "parameters": [
          {
            "name": "show_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Show Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reveal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alliance": {
        "properties": {
          "a": {
            "type": "string",
            "title": "A"
          },
          "b": {
            "type": "string",
            "title": "B"
          }
        },
        "type": "object",
        "required": [
          "a",
          "b"
        ],
        "title": "Alliance"
      },
      "Beat": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "section": {
            "type": "string",
            "enum": [
              "cold_open",
              "act_1",
              "act_2",
              "act_3",
              "coronation"
            ],
            "title": "Section"
          },
          "card": {
            "type": "string",
            "title": "Card"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "enum": [
              "single",
              "crowd",
              "drama",
              "structural"
            ],
            "title": "Kind"
          },
          "setting": {
            "type": "string",
            "enum": [
              "throne_room",
              "feast_hall",
              "battlefield",
              "ice_wall",
              "forest",
              "dungeon",
              "harbor",
              "city_streets",
              "temple",
              "bridge"
            ],
            "title": "Setting"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
            "title": "Roles"
          },
          "eliminations": {
            "items": {
              "$ref": "#/components/schemas/Elimination"
            },
            "type": "array",
            "title": "Eliminations"
          },
          "resurrections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Resurrections"
          },
          "alliances_formed": {
            "items": {
              "$ref": "#/components/schemas/Alliance"
            },
            "type": "array",
            "title": "Alliances Formed"
          },
          "alliances_broken": {
            "items": {
              "$ref": "#/components/schemas/Alliance"
            },
            "type": "array",
            "title": "Alliances Broken"
          },
          "facts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Facts",
            "description": "Card-specific outcome tags, e.g. attempt_failed."
          },
          "prophecy_hints": {
            "items": {
              "$ref": "#/components/schemas/ProphecyHint"
            },
            "type": "array",
            "title": "Prophecy Hints"
          },
          "budget_seconds": {
            "type": "integer",
            "title": "Budget Seconds"
          },
          "dramatic": {
            "type": "boolean",
            "title": "Dramatic"
          }
        },
        "type": "object",
        "required": [
          "index",
          "section",
          "card",
          "title",
          "kind",
          "setting",
          "roles",
          "eliminations",
          "resurrections",
          "alliances_formed",
          "alliances_broken",
          "facts",
          "prophecy_hints",
          "budget_seconds",
          "dramatic"
        ],
        "title": "Beat"
      },
      "Character": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable id: p01..p40 by canonical position, old_king, or npc_<role>."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "participant",
              "old_king",
              "npc"
            ],
            "title": "Kind"
          },
          "house": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "House"
          },
          "archetype": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "schemer",
                  "brute",
                  "fool",
                  "zealot",
                  "honorable",
                  "coward",
                  "bard"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Archetype"
          },
          "npc_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Npc Role"
          },
          "is_old_king": {
            "type": "boolean",
            "title": "Is Old King",
            "description": "True for the Old King, whether participant or not.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "title": "Character"
      },
      "Elimination": {
        "properties": {
          "character": {
            "type": "string",
            "title": "Character"
          },
          "mode": {
            "type": "string",
            "enum": [
              "killed",
              "forfeited",
              "exiled"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "character",
          "mode"
        ],
        "title": "Elimination"
      },
      "FateScript": {
        "properties": {
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "seal": {
            "type": "string",
            "title": "Seal"
          },
          "seed_mode": {
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ],
            "title": "Seed Mode"
          },
          "roster_size": {
            "type": "integer",
            "title": "Roster Size"
          },
          "characters": {
            "items": {
              "$ref": "#/components/schemas/Character"
            },
            "type": "array",
            "title": "Characters"
          },
          "houses": {
            "items": {
              "$ref": "#/components/schemas/House"
            },
            "type": "array",
            "title": "Houses"
          },
          "old_king": {
            "type": "string",
            "title": "Old King",
            "description": "Character id of the Old King."
          },
          "winner": {
            "type": "string",
            "title": "Winner",
            "description": "Character id of the participant who will be crowned."
          },
          "beats": {
            "items": {
              "$ref": "#/components/schemas/Beat"
            },
            "type": "array",
            "title": "Beats"
          },
          "total_budget_seconds": {
            "type": "integer",
            "title": "Total Budget Seconds"
          }
        },
        "type": "object",
        "required": [
          "engine_version",
          "seal",
          "seed_mode",
          "roster_size",
          "characters",
          "houses",
          "old_king",
          "winner",
          "beats",
          "total_budget_seconds"
        ],
        "title": "FateScript",
        "description": "The complete, fixed story timeline. Never contains the seed."
      },
      "FoundryHealth": {
        "properties": {
          "api_key": {
            "type": "boolean",
            "title": "Api Key"
          },
          "endpoint": {
            "type": "boolean",
            "title": "Endpoint"
          },
          "deployment": {
            "type": "boolean",
            "title": "Deployment"
          }
        },
        "type": "object",
        "required": [
          "api_key",
          "endpoint",
          "deployment"
        ],
        "title": "FoundryHealth"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "foundry": {
            "$ref": "#/components/schemas/FoundryHealth"
          }
        },
        "type": "object",
        "required": [
          "foundry"
        ],
        "title": "Health"
      },
      "House": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sigil": {
            "type": "string",
            "title": "Sigil"
          },
          "members": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Members",
            "description": "Character ids of the house members."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "sigil",
          "members"
        ],
        "title": "House"
      },
      "OldKing": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "is_mad_king": {
            "type": "boolean",
            "title": "Is Mad King",
            "description": "True when no previous winner was given."
          },
          "is_participant": {
            "type": "boolean",
            "title": "Is Participant",
            "description": "True when the previous winner also competes."
          }
        },
        "type": "object",
        "required": [
          "name",
          "is_mad_king",
          "is_participant"
        ],
        "title": "OldKing"
      },
      "Participant": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "is_old_king": {
            "type": "boolean",
            "title": "Is Old King",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Participant"
      },
      "ProphecyHint": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Machine-readable fact id, for example 'betrayed' or 'house:goat'."
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Plain English hint that does not name the winner."
          }
        },
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "ProphecyHint"
      },
      "Reveal": {
        "properties": {
          "seed": {
            "type": "string",
            "title": "Seed"
          },
          "seed_mode": {
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ],
            "title": "Seed Mode"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "seal": {
            "type": "string",
            "title": "Seal"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "seed_mode",
          "engine_version",
          "seal"
        ],
        "title": "Reveal"
      },
      "Role": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "character": {
            "type": "string",
            "title": "Character"
          }
        },
        "type": "object",
        "required": [
          "role",
          "character"
        ],
        "title": "Role"
      },
      "ShowRequest": {
        "properties": {
          "participants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Participants",
            "description": "Participant names, one per entry; blanks are ignored."
          },
          "old_king": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Old King",
            "description": "Previous winner; empty means the Mad King."
          },
          "seed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Manual seed; empty means automatic."
          }
        },
        "type": "object",
        "required": [
          "participants"
        ],
        "title": "ShowRequest"
      },
      "ShowSession": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/Participant"
            },
            "type": "array",
            "title": "Participants"
          },
          "old_king": {
            "$ref": "#/components/schemas/OldKing"
          },
          "seed_mode": {
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ],
            "title": "Seed Mode"
          }
        },
        "type": "object",
        "required": [
          "id",
          "participants",
          "old_king",
          "seed_mode"
        ],
        "title": "ShowSession",
        "description": "Public view of a show session. The seed itself is never included."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
